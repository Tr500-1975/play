<?xml version="1.0" encoding="UTF-8"?>
<window id="10134">
    <defaultcontrol always="true">450</defaultcontrol>
    <views>450</views>
    
    <controls>
        <!-- FONDO -->
        <include>CommonBackground</include>

        <control type="image">
            <width>1920</width>
            <height>150</height>
            <texture>gradient.png</texture>
            <colordiffuse>AA000000</colordiffuse>
        </control>

        <control type="group">
            <left>0</left>
            <top>0</top>

            <control type="label">
                <left>80</left>
                <top>45</top>
                <width>1000</width>
                <height>60</height>
                <font>font30_title</font>
                <label>MIS FAVORITOS</label>
                <textcolor>$VAR[MainColorOne]</textcolor>
                <shadowcolor>black</shadowcolor>
            </control>

            <control type="button" id="10">
                <left>1800</left>
                <top>40</top>
                <width>80</width>
                <height>60</height>
                <label>X</label>
                <font>font14_title</font>
                <align>center</align>
                <texturefocus border="5" colordiffuse="$VAR[MainColorOne]">HomeSubFO.png</texturefocus>
                <texturenofocus border="5">HomeSubNF.png</texturenofocus>
                <onclick>Action(Back)</onclick>
                <onleft>450</onleft>
                <ondown>450</ondown>
            </control>

            <!-- CAMBIO 1: De "list" a "panel" para que sea una cuadrícula (Línea 54 aprox) -->
            <control type="panel" id="450">
                <left>80</left>
                <top>140</top>
                <width>1760</width>
                <height>850</height>
                <onleft>10</onleft>
                <onright>450</onright>
                <onup>10</onup>
                <ondown>450</ondown>
                <pagecontrol>60</pagecontrol>
                <scrolltime>200</scrolltime>
                
                <!-- CAMBIO 2: Dimensiones de cada "caja" (Antes 1760x90, ahora 280x380) -->
                <itemlayout width="290" height="380">
                    <control type="image">
                        <width>280</width>
                        <height>350</height>
                        <texture border="5">HomeSubNF.png</texture>
                    </control>
                    <!-- Carátula Grande -->
                    <control type="image">
                        <left>10</left>
                        <top>10</top>
                        <width>260</width>
                        <height>260</height>
                        <texture>$INFO[ListItem.Icon]</texture>
                        <aspectratio>keep</aspectratio>
                    </control>
                    <!-- Texto debajo de la carátula -->
                    <control type="label">
                        <left>10</left>
                        <top>275</top>
                        <width>260</width>
                        <height>60</height>
                        <font>font12</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>white</textcolor>
                        <align>center</align> <!-- Centramos el texto -->
                        <aligny>top</aligny>
                    </control>
                </itemlayout>

                <!-- CAMBIO 3: Lo mismo para el elemento seleccionado -->
                <focusedlayout width="290" height="380">
                    <control type="image">
                        <width>280</width>
                        <height>350</height>
                        <texture border="5" colordiffuse="$VAR[MainColorOne]">HomeSubFO.png</texture>
                    </control>
                    <control type="image">
                        <left>10</left>
                        <top>10</top>
                        <width>260</width>
                        <height>260</height>
                        <texture>$INFO[ListItem.Icon]</texture>
                        <aspectratio>keep</aspectratio>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>275</top>
                        <width>260</width>
                        <height>60</height>
                        <font>font12_title</font>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>white</textcolor>
                        <align>center</align>
                        <aligny>top</aligny>
                    </control>
                </focusedlayout>
            </control>
            
            <control type="label">
                <left>0</left>
                <top>500</top>
                <width>1920</width>
                <height>60</height>
                <font>font13</font>
                <label>No hay elementos en favoritos</label>
                <align>center</align>
                <visible>Integer.IsEqual(Container(450).NumItems,0)</visible>
            </control>

        </control>
    </controls>
</window>